[8.248283, "o", "\u250f\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2513\r\n"]
[8.248517, "o", "\u2503\u001b[1m \u001b[0m\u001b[1m#\u001b[0m\u001b[1m \u001b[0m\u2503\u001b[1m \u001b[0m\u001b[1mstep                                                \u001b[0m\u001b[1m \u001b[0m\u2503\u001b[1m \u001b[0m\u001b[1mresult\u001b[0m\u001b[1m \u001b[0m\u2503\u001b[1m \u001b[0m\u001b[1mtime\u001b[0m\u001b[1m \u001b[0m\u2503\u001b[1m \u001b[0m\u001b[1mdetail       \u001b[0m\u001b[1m \u001b[0m\u2503\r\n"]
[8.248583, "o", "\u2521\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2529\r\n"]
[8.248737, "o", "\u2502 1 \u2502 Getting set up                                       \u2502 \u001b[32m\u2713 ok\u001b[0m   \u2502 0.0s \u2502               \u2502\r\n"]
[8.24881, "o", "\u2502 2 \u2502 export GREETING=\"hello from showrun\"                 \u2502 \u001b[32m\u2713 ok\u001b[0m   \u2502 0.0s \u2502               \u2502\r\n"]
[8.248878, "o", "\u2502 3 \u2502 echo \"$GREETING\"                                     \u2502 \u001b[32m\u2713 ok\u001b[0m   \u2502 0.0s \u2502               \u2502\r\n"]
[8.248942, "o", "\u2502 4 \u2502 cat > app.txt <<'EOF'                                \u2502 \u001b[32m\u2713 ok\u001b[0m   \u2502 0.0s \u2502               \u2502\r\n"]
[8.249008, "o", "\u2502 5 \u2502 cat app.txt                                          \u2502 \u001b[32m\u2713 ok\u001b[0m   \u2502 0.0s \u2502               \u2502\r\n"]
[8.249071, "o", "\u2502 6 \u2502 Services                                             \u2502 \u001b[32m\u2713 ok\u001b[0m   \u2502      \u2502               \u2502\r\n"]
[8.249136, "o", "\u2502 7 \u2502 curl -s http://127.0.0.1:8765/ | grep -m1 -o         \u2502 \u001b[32m\u2713 ok\u001b[0m   \u2502 0.0s \u2502               \u2502\r\n"]
[8.249188, "o", "\u2502   \u2502 'app.txt'                                            \u2502        \u2502      \u2502               \u2502\r\n"]
[8.249262, "o", "\u2502 8 \u2502 Safety nets                                          \u2502 \u001b[2m\u2013 skip\u001b[0m \u2502      \u2502 canned output \u2502\r\n"]
[8.249341, "o", "\u2502 9 \u2502 ls /does-not-exist                                   \u2502 \u001b[32m\u2713 ok\u001b[0m   \u2502 0.0s \u2502               \u2502\r\n"]
[8.250221, "o", "\u2514\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\n"]
[8.287813, "o", "\u001b[1;33m\u25b6 \u001b[0m\u001b[1;30;43mall good\u001b[0m\u001b[1;33m  \u001b[0m\u001b[1;2;33m(\u001b[0m\u001b[1;2;33mcommand time \u001b[0m\u001b[1;2;36m0.\u001b[0m\u001b[1;2;33m0s\u001b[0m\u001b[1;2;33m)\u001b[0m\r\n"]
[8.288064, "m", "showrun export examples/tour.yaml -f md | head -20"]
