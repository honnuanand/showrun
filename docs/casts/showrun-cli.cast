[3.361058, "o", "\u001b[3m                              showrun tour                               \u001b[0m\r\n\u250f\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2513\r\n\u2503\u001b[1m \u001b[0m\u001b[1m# \u001b[0m\u001b[1m \u001b[0m\u2503\u001b[1m \u001b[0m\u001b[1mkind  \u001b[0m\u001b[1m \u001b[0m\u2503\u001b[1m \u001b[0m\u001b[1mstep                                                   \u001b[0m\u001b[1m \u001b[0m\u2503\r\n\u2521\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2529\r\n\u2502 1  \u2502 run    \u2502 Getting set up                                          \u2502\r\n\u2502 2  \u2502 hidden \u2502 export GREETING=\"hello from showrun\"                    \u2502\r\n\u2502 3  \u2502 run    \u2502 echo \"$GREETING\"                                        \u2502\r\n\u2502 4  \u2502 run    \u2502 cat > app.txt <<'EOF'             "]
[3.361219, "o", "                      \u2502\r\n\u2502 5  \u2502 run    \u2502 cat app.txt                                             \u2502\r\n\u2502 6  \u2502 bg     \u2502 Services                                                \u2502\r\n\u2502 7  \u2502 run    \u2502 curl -s http://127.0.0.1:8765/ | grep -m1 -o 'app.txt'  \u2502\r\n\u2502 8  \u2502 canned \u2502 Safety nets                                             \u2502\r\n\u2502 9  \u2502 run    \u2502 ls /does-not-exist                                      \u2502\r\n\u2502 10 \u2502 say    \u2502 say: That's the tour. Try `showrun record my-demo.yaml` \u2502\r\n\u2514\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
